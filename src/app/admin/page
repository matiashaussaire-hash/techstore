"use client";

import { useCallback, useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import { Navbar } from "@/components/navbar";
import { AdminPanel } from "@/components/admin-panel";
import { useAuth } from "@/context/auth-context";
import { isAdminUser } from "@/lib/admin";
import { getAllOrders } from "@/lib/orders";
import type { Order } from "@/types/product";

function deliveryMethodLabel(method?: string): string {
  switch (method) {
    case "pickup":
      return "Retiro en local";
    case "delivery":
      return "Envío a domicilio";
    default:
      return "No especificado";
  }
}

function statusLabel(status: string): string {
  switch (status) {
    case "approved":
      return "Aprobado";
    case "pending":
      return "Pendiente";
    case "rejected":
      return "Rechazado";
    case "cancelled":
      return "Cancelado";
    default:
      return status;
  }
}

function statusColor(status: string): string {
  switch (status) {
    case "approved":
      return "bg-emerald-500/10 text-emerald-300";
    case "pending":
      return "bg-amber-500/10 text-amber-300";
    case "rejected":
      return "bg-rose-500/10 text-rose-300";
    case "cancelled":
      return "bg-slate-500/10 text-slate-400";
    default:
      return "bg-slate-500/10 text-slate-400";
  }
}

export default function AdminPage() {
  const { user } = useAuth();
  const router = useRouter();
  const [adminPanelOpen, setAdminPanelOpen] = useState(false);
  const [checking, setChecking] = useState(true);
  const [orders, setOrders] = useState<Order[]>([]);
  const [loadingOrders, setLoadingOrders] = useState(true);
  const [showOrders, setShowOrders] = useState(false);

  const isUserAdmin = isAdminUser(user);

  const fetchOrders = useCallback(async () => {
    try {
      const allOrders = await getAllOrders();
      setOrders(allOrders);
    } catch (err) {
      console.error("[admin] Error fetching orders:", err);
    } finally {
      setLoadingOrders(false);
    }
  }, []);

  useEffect(() => {
    if (user === undefined) return;
    if (!isUserAdmin) {
      router.replace("/");
    } else {
      setAdminPanelOpen(true);
      setChecking(false);
    }
  }, [user, isUserAdmin, router]);

  useEffect(() => {
    if (isUserAdmin && showOrders) {
      fetchOrders();
    }
  }, [isUserAdmin, showOrders, fetchOrders]);

  if (checking && user === undefined) {
    return (
      <div className="min-h-screen bg-slate-950">
        <Navbar />
        <main className="mx-auto max-w-5xl px-4 py-16 text-center text-slate-400">
          Verificando acceso...
        </main>
      </div>
    );
  }

  if (!isUserAdmin) {
    return (
      <div className="min-h-screen bg-slate-950">
        <Navbar />
        <main className="mx-auto max-w-5xl px-4 py-16 text-center text-slate-400">
          Redirigiendo...
        </main>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-slate-950">
      <Navbar />
      <main className="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <div className="rounded-[2rem] border border-white/10 bg-slate-900/70 p-8 text-center">
          <h1 className="text-2xl font-semibold text-white">Panel de Administración</h1>
          <p className="mt-2 text-slate-400">
            Gestioná los productos y revisá los pedidos de la tienda.
          </p>
          <div className="mt-6 flex flex-wrap justify-center gap-3">
            <button
              type="button"
              onClick={() => setAdminPanelOpen(true)}
              className="cursor-pointer rounded-full bg-cyan-500 px-6 py-3 font-medium text-slate-950 transition-all hover:brightness-110"
            >
              Gestionar productos
            </button>
            <button
              type="button"
              onClick={() => setShowOrders((v) => !v)}
              className="cursor-pointer rounded-full border border-white/10 px-6 py-3 font-medium text-slate-300 transition-all hover:border-cyan-400/40 hover:bg-cyan-500/10 hover:text-cyan-300"
            >
              {showOrders ? "Ocultar pedidos" : "Ver pedidos"}
            </button>
          </div>
        </div>

        {showOrders && (
          <section className="mt-8 rounded-[2rem] border border-white/10 bg-slate-900/70 p-6">
            <h2 className="text-xl font-semibold text-white">Pedidos</h2>

            {loadingOrders ? (
              <p className="mt-4 text-sm text-slate-500">Cargando pedidos...</p>
            ) : orders.length === 0 ? (
              <p className="mt-4 text-sm text-slate-500">Todavía no hay pedidos registrados.</p>
            ) : (
              <div className="mt-4 space-y-3">
                {orders.map((order) => (
                  <div
                    key={order.id}
                    className="rounded-2xl border border-white/10 bg-slate-950/70 p-4"
                  >
                    <div className="flex flex-wrap items-center justify-between gap-3">
                      <div>
                        <p className="font-medium text-white">{order.id}</p>
                        <p className="text-xs text-slate-500">
                          {new Date(order.createdAt).toLocaleString("es-AR", {
                            dateStyle: "short",
                            timeStyle: "short",
                          })}
                        </p>
                      </div>
                      <span
                        className={`rounded-full px-3 py-1 text-xs ${statusColor(order.status)}`}
                      >
                        {statusLabel(order.status)}
                      </span>
                    </div>

                    <div className="mt-3 grid gap-2 text-sm text-slate-400 sm:grid-cols-2">
                      <div>
                        <span className="text-slate-500">Cliente:</span>{" "}
                        {order.customerName}
                      </div>
                      <div>
                        <span className="text-slate-500">Email:</span>{" "}
                        {order.email}
                      </div>
                      <div>
                        <span className="text-slate-500">Teléfono:</span>{" "}
                        {order.address.phone}
                      </div>
                      <div>
                        <span className="text-slate-500">Entrega:</span>{" "}
                        {deliveryMethodLabel(order.deliveryMethod)}
                      </div>
                      <div className="sm:col-span-2">
                        <span className="text-slate-500">Dirección:</span>{" "}
                        {order.address.address}, {order.address.city}, {order.address.state},{" "}
                        {order.address.postalCode}, {order.address.country}
                      </div>
                    </div>

                    <div className="mt-3 border-t border-white/5 pt-3">
                      <p className="text-xs font-medium text-slate-500 mb-1">Productos</p>
                      {order.items.map((item, idx) => (
                        <div
                          key={idx}
                          className="flex items-center justify-between text-sm text-slate-400"
                        >
                          <span>
                            {item.product.name} × {item.quantity}
                          </span>
                          <span>
                            ${(item.product.price * item.quantity).toLocaleString("es-AR")}
                          </span>
                        </div>
                      ))}
                    </div>

                    <div className="mt-3 flex items-center justify-between border-t border-white/5 pt-3">
                      <span className="text-sm text-slate-500">Total</span>
                      <span className="text-lg font-semibold text-white">
                        ${order.total.toLocaleString("es-AR")}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            )}

            <p className="mt-6 rounded-xl border border-amber-400/20 bg-amber-500/5 px-4 py-3 text-xs text-amber-300/80">
              ℹ️ La logística de envío (empresa de envíos, costos, seguimiento y despacho)
              es responsabilidad del negocio y debe coordinarse fuera del sistema.
              El sistema notifica al administrador por email cuando un pago es aprobado.
            </p>
          </section>
        )}
      </main>

      <AdminPanel
        isOpen={adminPanelOpen}
        onClose={() => setAdminPanelOpen(false)}
      />
    </div>
  );
}